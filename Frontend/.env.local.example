# Copy to .env.local for local Next.js. This file is a TEMPLATE only.
# Do not paste production secrets here before committing.

# --- Database (Neon) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- SMS Alert (optional) ---
SMSALERT_API_KEY=
SMSALERT_SENDER=
SMSALERT_OTP_TEMPLATE=Your Divas Sojourn OTP is [otp length="6" retry="3" validity="10"]

# --- Admin panel ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_AUTH_SECRET=
AUTH_SECRET=

# Dev-only — never set on Vercel
# MOCK_OTP=
