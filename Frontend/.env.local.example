# Copy to .env.local for local Next.js. This file is a TEMPLATE only.
# Do not paste production secrets here before committing.

# --- Database (Neon) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- SMS Alert (itinerary phone OTP) ---
SMSALERT_API_KEY=
SMSALERT_SENDER=
SMSALERT_OTP_TEMPLATE=Your verification code for mobile verification is [otp length="4" retry="3" validity="10"]

# --- Admin panel ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_AUTH_SECRET=
AUTH_SECRET=

# Dev-only — never set on Vercel
# MOCK_OTP=

# --- Google Places (reviews; server-only) ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
CRON_SECRET=

# --- Vercel Blob (admin uploads on Vercel / optional locally) ---
BLOB_READ_WRITE_TOKEN=
