# Copy to .env (Prisma) and/or .env.local (Next.js)

# SQLite local database (Prisma). Switch to postgresql + a real URL for production.
DATABASE_URL="file:./dev.db"

# Traveler phone OTP auth
AUTH_SECRET=change-this-to-a-long-random-string
# Dev-only shortcut so you can log in without a real SMS provider. Ignored
# automatically when NODE_ENV=production, even if this stays set on a host
# by accident — but do not rely on that, just leave it unset in production.
MOCK_OTP=123456

# Admin panel auth (Phase 1 — single hardcoded admin user)
ADMIN_EMAIL=admin@divassojourn.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_AUTH_SECRET=change-this-to-another-long-random-string
