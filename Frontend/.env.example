# Copy to .env (Prisma) and/or .env.local (Next.js)
# NEVER put real secrets in this file — only placeholders.
# Real values live only in .env.local (gitignored) and in Vercel → Settings → Environment Variables.

# --- Database (Neon on Vercel) ---
# Vercel Storage → Neon usually injects these names automatically:
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- Clerk (traveler sign-in / sign-up) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- SMS Alert OTP (optional; post-signup phone verification — server only) ---
SMSALERT_API_KEY=
SMSALERT_SENDER=
# Must include [otp] tag. Use your DLT-approved template in production.
SMSALERT_OTP_TEMPLATE=Your Divas Sojourn OTP is [otp length="6" retry="3" validity="10"]

# --- Admin panel (required on Vercel) ---
# Client opens: https://YOUR-APP.vercel.app/admin/login
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_AUTH_SECRET=

# Optional legacy alias used by some session helpers
AUTH_SECRET=

# Dev-only. Leave UNSET on Vercel / production.
# MOCK_OTP=

# --- Google Places (reviews cache; server-only) ---
# Enable Places API (Place Details) in Google Cloud, then set:
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Shared secret for /api/cron/google-reviews (Vercel Cron Authorization header)
CRON_SECRET=

# --- Vercel Blob (admin image/PDF uploads on Vercel) ---
# Vercel Dashboard → Storage → Create Blob store → connect to this project.
# Token is usually injected automatically as BLOB_READ_WRITE_TOKEN.
# Must be present for Production (and Preview if you use preview admin URLs), then Redeploy.
# Cover images on Vercel must be JPG/PNG/WebP under ~4MB (server body limit).
BLOB_READ_WRITE_TOKEN=
